#!/usr/bin/env zsh

set -u
set -o pipefail

AWS_PLAN_ROOT="${0:A:h}"
source "$AWS_PLAN_ROOT/aws-plan-setup-lib.zsh"
source "$AWS_PLAN_ROOT/aws-plan-ui.zsh"
source "$AWS_PLAN_ROOT/aws-plan-state.zsh"
source "$AWS_PLAN_ROOT/aws-plan-services.zsh"
source "$AWS_PLAN_ROOT/aws-plan-questions.zsh"
source "$AWS_PLAN_ROOT/aws-plan-decisions.zsh"
source "$AWS_PLAN_ROOT/aws-plan-region.zsh"
source "$AWS_PLAN_ROOT/aws-plan-report.zsh"
source "$AWS_PLAN_ROOT/aws-plan-graph-registry.zsh"
source "$AWS_PLAN_ROOT/aws-plan-graph-resources.zsh"
source "$AWS_PLAN_ROOT/aws-plan-graph-relationships.zsh"
source "$AWS_PLAN_ROOT/aws-plan-graph-active.zsh"
source "$AWS_PLAN_ROOT/aws-plan-graph-labels.zsh"
source "$AWS_PLAN_ROOT/aws-plan-graph-layout.zsh"
source "$AWS_PLAN_ROOT/aws-plan-graph-edges.zsh"
source "$AWS_PLAN_ROOT/aws-plan-graph-audit.zsh"
source "$AWS_PLAN_ROOT/aws-plan-plan-write.zsh"
source "$AWS_PLAN_ROOT/aws-plan-render.zsh"

aws_setup_init "$0"
aws_plan_ui_init
aws_plan_state_init
aws_plan_services_init
aws_plan_header
aws_plan_collect_questions
aws_plan_derive
aws_plan_region
aws_plan_report
aws_plan_graph_registry_init
aws_plan_graph_resources_init
aws_plan_graph_relationships_init
aws_plan_graph_active_init
aws_plan_graph_layout
aws_plan_graph_edges
aws_plan_graph_audit
if ! aws_plan_write_plan || [[ ! -s ${PLAN_JSON_FILE:-} ]]; then
  print -u2 -r -- "Failed to write the plan file: ${PLAN_JSON_FILE:-}"
  exit 1
fi

print
say "${B}==========================================================================${R}"
say "${B}${G}UNIFIED ACTIVE ARCHITECTURE + IMPLEMENTATION GRAPH${R}"
say "${B}==========================================================================${R}"
say "${D}Circles = umbrella AWS services. Boxes = concrete resources owned by those services.${R}"
say "${D}Dotted = explicit setup/configuration action. Solid = intrinsic architecture relationship.${R}"
say "${D}Mermaid groups categories and places each relationship title on a dedicated node in its connection path.${R}"
say
say "${B}Combined architecture map:${R}"
say "  Mermaid: $MERMAID_FILE"
aws_plan_render_graph "$MERMAID_FILE" "$SVG_FILE" "$PNG_FILE" "$ERR_FILE"

say
say "${B}Planner complete.${R}"
say "${D}Plan: $PLAN_JSON_FILE${R}"
say "${D}Graph audit: $GRAPH_AUDIT_FILE${R}"
say "${D}The graph derives circle relationships from the concrete resource relationship table; there is no second service-level relationship matrix to drift out of sync.${R}"
