aws_plan_graph_registry_init() {
  typeset -ga GRAPH_SERVICE_IDS GRAPH_CATEGORY_ORDER
  typeset -gA GRAPH_SERVICE_NAME GRAPH_SERVICE_CATEGORY GRAPH_SERVICE_CLASS GRAPH_CATEGORY_TITLE GRAPH_CATEGORY_COLOR
  typeset -g MERMAID_FILE PNG_FILE SVG_FILE ERR_FILE GRAPH_AUDIT_FILE PLAN_JSON_FILE

MERMAID_FILE="$AWS_SETUP_OUT/architecture.mmd"
PNG_FILE="$AWS_SETUP_OUT/architecture.png"
SVG_FILE="$AWS_SETUP_OUT/architecture.svg"
ERR_FILE="$AWS_SETUP_OUT/mermaid.log"
GRAPH_AUDIT_FILE="$AWS_SETUP_OUT/graph-audit.md"
PLAN_JSON_FILE="$AWS_SETUP_OUT/plan.json"

GRAPH_SERVICE_IDS=(IAM VPC SSM EC2 LAMBDA S3 FSXLUSTRE DCV PCS PC BATCH ECR DEADLINE BEDROCK SAGE BUDGET COSTEXP CW)
typeset -gA GRAPH_SERVICE_NAME GRAPH_SERVICE_CATEGORY GRAPH_SERVICE_CLASS
GRAPH_SERVICE_NAME[IAM]='AWS IAM'
GRAPH_SERVICE_NAME[VPC]='AWS VPC'
GRAPH_SERVICE_NAME[SSM]='Session Manager'
GRAPH_SERVICE_NAME[EC2]='Amazon EC2'
GRAPH_SERVICE_NAME[LAMBDA]='AWS Lambda'
GRAPH_SERVICE_NAME[S3]='Amazon S3'
GRAPH_SERVICE_NAME[FSXLUSTRE]='Amazon FSx for Lustre'
GRAPH_SERVICE_NAME[DCV]='Amazon DCV'
GRAPH_SERVICE_NAME[PCS]='AWS PCS'
GRAPH_SERVICE_NAME[PC]='AWS ParallelCluster'
GRAPH_SERVICE_NAME[BATCH]='AWS Batch'
GRAPH_SERVICE_NAME[ECR]='Amazon ECR'
GRAPH_SERVICE_NAME[DEADLINE]='AWS Deadline Cloud'
GRAPH_SERVICE_NAME[BEDROCK]='Amazon Bedrock'
GRAPH_SERVICE_NAME[SAGE]='Amazon SageMaker AI'
GRAPH_SERVICE_NAME[BUDGET]='AWS Budgets'
GRAPH_SERVICE_NAME[COSTEXP]='AWS Cost Explorer'
GRAPH_SERVICE_NAME[CW]='Amazon CloudWatch'

for id in IAM VPC SSM; do GRAPH_SERVICE_CATEGORY[$id]='security'; done
GRAPH_SERVICE_CATEGORY[EC2]='compute'; GRAPH_SERVICE_CATEGORY[LAMBDA]='compute'
GRAPH_SERVICE_CATEGORY[S3]='storage'; GRAPH_SERVICE_CATEGORY[FSXLUSTRE]='storage'
GRAPH_SERVICE_CATEGORY[DCV]='gui'
for id in PCS PC; do GRAPH_SERVICE_CATEGORY[$id]='hpc'; done
for id in BATCH ECR DEADLINE; do GRAPH_SERVICE_CATEGORY[$id]='pipeline'; done
for id in BEDROCK SAGE; do GRAPH_SERVICE_CATEGORY[$id]='ai'; done
for id in BUDGET COSTEXP CW; do GRAPH_SERVICE_CATEGORY[$id]='telemetry'; done

GRAPH_SERVICE_CLASS[IAM]='svc_sec'; GRAPH_SERVICE_CLASS[VPC]='svc_sec'; GRAPH_SERVICE_CLASS[SSM]='svc_sec'
GRAPH_SERVICE_CLASS[EC2]='svc_compute'; GRAPH_SERVICE_CLASS[LAMBDA]='svc_compute'
GRAPH_SERVICE_CLASS[S3]='svc_storage'; GRAPH_SERVICE_CLASS[FSXLUSTRE]='svc_storage'
GRAPH_SERVICE_CLASS[DCV]='svc_gui'; GRAPH_SERVICE_CLASS[PCS]='svc_hpc'; GRAPH_SERVICE_CLASS[PC]='svc_hpc'
GRAPH_SERVICE_CLASS[BATCH]='svc_pipe'; GRAPH_SERVICE_CLASS[ECR]='svc_pipe'; GRAPH_SERVICE_CLASS[DEADLINE]='svc_pipe'
GRAPH_SERVICE_CLASS[BEDROCK]='svc_ai'; GRAPH_SERVICE_CLASS[SAGE]='svc_ai'
GRAPH_SERVICE_CLASS[BUDGET]='svc_telemetry'; GRAPH_SERVICE_CLASS[COSTEXP]='svc_telemetry'; GRAPH_SERVICE_CLASS[CW]='svc_telemetry'

typeset -gA GRAPH_CATEGORY_TITLE GRAPH_CATEGORY_COLOR
GRAPH_CATEGORY_TITLE[security]='Security & Access'; GRAPH_CATEGORY_COLOR[security]='#60a5fa'
GRAPH_CATEGORY_TITLE[compute]='Compute'; GRAPH_CATEGORY_COLOR[compute]='#4ade80'
GRAPH_CATEGORY_TITLE[storage]='Storage & File Systems'; GRAPH_CATEGORY_COLOR[storage]='#fb923c'
GRAPH_CATEGORY_TITLE[gui]='Remote GUI'; GRAPH_CATEGORY_COLOR[gui]='#c084fc'
GRAPH_CATEGORY_TITLE[hpc]='HPC & Cluster'; GRAPH_CATEGORY_COLOR[hpc]='#f43f5e'
GRAPH_CATEGORY_TITLE[pipeline]='Pipelines & Render Farm'; GRAPH_CATEGORY_COLOR[pipeline]='#22d3ee'
GRAPH_CATEGORY_TITLE[ai]='Managed AI'; GRAPH_CATEGORY_COLOR[ai]='#f0abfc'
GRAPH_CATEGORY_TITLE[telemetry]='Telemetry & Guardrails'; GRAPH_CATEGORY_COLOR[telemetry]='#facc15'
GRAPH_CATEGORY_ORDER=(security compute storage gui hpc pipeline ai telemetry)


}
